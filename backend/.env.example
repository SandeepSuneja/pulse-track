# Copy to .env and fill in values from Firebase Console
# Project settings → Service accounts → Generate new private key

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project.iam.gserviceaccount.com

# Or place the downloaded JSON at backend/firebase-service-account.json
# and leave the vars above empty — the app will load that file instead.
# Do not copy that JSON into the Docker image; use env vars / SSM in production.

# Local development (default)
DATABASE_URL=sqlite:///./pulse_track.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production (AWS RDS + CloudFront) — set these on App Runner instead of this file:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@RDS_ENDPOINT:5432/pulsetrack
# CORS_ORIGINS=https://dxxxx.cloudfront.net
# postgres:// and postgresql:// URLs are also accepted and rewritten to psycopg2.

# Never enable in production (web or mobile).
DEV_SKIP_AUTH=false
