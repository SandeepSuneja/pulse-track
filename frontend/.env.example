# Local development
VITE_API_URL=http://127.0.0.1:8000

# Production builds use frontend/.env.production (Lambda HTTP API).
# Override here only for local experiments against a different origin.
# VITE_API_URL=https://d896tye5ji.execute-api.us-east-1.amazonaws.com

# From Firebase Console → Project settings → Your apps → Web app config
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
