# Local development
VITE_API_URL=http://127.0.0.1:8000

# Production: App Runner HTTPS origin (same URL the mobile app will call).
# This value is baked in at `npm run build` — rebuild if the API URL changes.
# VITE_API_URL=https://xxxx.ap-south-1.awsapprunner.com

# From Firebase Console → Project settings → Your apps → Web app config
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
